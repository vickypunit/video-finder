# ---- Server ----
PORT=4000
LOG_LEVEL=info
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
DB_PATH=./data/app.db

# ---- Provider mode ----
# "live" uses real platform APIs below. "mock" returns clearly-flagged synthetic
# videos so you can develop / run tests without any keys.
PROVIDER_MODE=mock

# ---- Image brain (Anthropic API, vision) ----
# Leave empty to fall back to a simple keyword heuristic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Instagram (official Graph API, Hashtag Search) ----
# Needs an Instagram Business/Creator account linked to a Facebook app.
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---- Meta Ad Library API ----
META_ACCESS_TOKEN=
# Countries whose ads should be searched (ISO codes, comma separated)
META_AD_COUNTRIES=GB,DE,FR

# ---- TikTok (optional, off unless enabled) ----
TIKTOK_ENABLED=false
TIKTOK_ACCESS_TOKEN=

# ---- Collection settings ----
MIN_VIDEOS_PER_SOURCE=20
MAX_PAGES_PER_SOURCE=8
RATE_LIMIT_PER_MINUTE=20
