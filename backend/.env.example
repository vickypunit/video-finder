# ---- Server ----
PORT=4000
LOG_LEVEL=info
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
DB_PATH=./data/app.db

# ---- Provider mode ----
# "live" uses real platform APIs below. "mock" returns clearly-flagged synthetic
# videos so you can develop / run tests without any keys.
PROVIDER_MODE=mock

# ---- Image brain (Anthropic API, vision) ----
# Leave empty to fall back to a simple keyword heuristic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Instagram (official Graph API, Hashtag Search) ----
# Needs an Instagram Business/Creator account linked to a Facebook app.
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---- Meta Ad Library API ----
META_ACCESS_TOKEN=
# Countries whose ads should be searched (ISO codes, comma separated)
META_AD_COUNTRIES=GB,DE,FR

# ---- TikTok (optional, off unless enabled) ----
TIKTOK_ENABLED=false
TIKTOK_ACCESS_TOKEN=

# ---- Scoring ----
# Videos scoring below this are flagged "low match" (kept, but marked and filterable)
MATCH_THRESHOLD=40
# Product photo vs thumbnail comparison: videos per vision call / max videos compared per search
VISUAL_BATCH_SIZE=6
MAX_VISUAL_VIDEOS=60
# OPTIONAL and off by default. Instagram's hashtag API returns no thumbnail for Reels, so this tries
# the public og:image of each permalink (instagram.com only). Read the README before enabling.
ENRICH_THUMBNAILS=false

# ---- Reliability ----
PAGE_TIMEOUT_MS=20000
SOURCE_TIMEOUT_MS=90000
COLLECTOR_RETRIES=2
CACHE_TTL_MS=900000
JOB_CONCURRENCY=2
MAX_UPLOAD_BYTES=1572864

# ---- Collection settings ----
MIN_VIDEOS_PER_SOURCE=20
MAX_PAGES_PER_SOURCE=8
RATE_LIMIT_PER_MINUTE=20
